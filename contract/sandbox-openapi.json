{
  "openapi": "3.1.1",
  "info": {
    "title": "CAIL Sandbox Gateway",
    "version": "0.1.0",
    "description": "Bounded CAIL-governed remote execution. Sandbox IDs are identifiers, not authorization credentials."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }, { "identityJwtV2": [] }, { "identityJwt": [] }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": { "description": "Liveness only", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/sandbox/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "parameters": [{ "$ref": "#/components/parameters/App" }],
        "responses": {
          "200": { "description": "This OpenAPI document", "content": { "application/json": { "schema": { "type": "object" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sandbox/v1/sandbox": {
      "post": {
        "operationId": "createSandbox",
        "parameters": [{ "$ref": "#/components/parameters/App" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSandboxRequest" } } } },
        "responses": {
          "201": { "description": "Sandbox admitted and created", "headers": { "X-CAIL-Sandbox-Quota-Limit": { "$ref": "#/components/headers/SandboxQuotaLimit" }, "X-CAIL-Sandbox-Quota-Used": { "$ref": "#/components/headers/SandboxQuotaUsed" }, "X-CAIL-Sandbox-Quota-Remaining": { "$ref": "#/components/headers/SandboxQuotaRemaining" }, "X-CAIL-Sandbox-Quota-Unit": { "$ref": "#/components/headers/SandboxQuotaUnit" }, "X-CAIL-Sandbox-Quota-Mode": { "$ref": "#/components/headers/SandboxQuotaMode" }, "X-CAIL-Sandbox-Quota-State": { "$ref": "#/components/headers/SandboxQuotaState" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SandboxLifecycle" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sandbox/v1/sandbox/{id}": {
      "delete": {
        "operationId": "destroySandbox",
        "parameters": [{ "$ref": "#/components/parameters/SandboxId" }, { "$ref": "#/components/parameters/App" }, { "$ref": "#/components/parameters/LeaseCapability" }],
        "responses": {
          "204": { "description": "Destroyed or already destroyed" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sandbox/v1/sandbox/{id}/running": {
      "get": {
        "operationId": "isSandboxRunning",
        "parameters": [{ "$ref": "#/components/parameters/SandboxId" }, { "$ref": "#/components/parameters/App" }, { "$ref": "#/components/parameters/LeaseCapability" }],
        "responses": {
          "200": { "description": "Current liveness and CAIL lifecycle", "headers": { "X-CAIL-Sandbox-Quota-Limit": { "$ref": "#/components/headers/SandboxQuotaLimit" }, "X-CAIL-Sandbox-Quota-Used": { "$ref": "#/components/headers/SandboxQuotaUsed" }, "X-CAIL-Sandbox-Quota-Remaining": { "$ref": "#/components/headers/SandboxQuotaRemaining" }, "X-CAIL-Sandbox-Quota-Unit": { "$ref": "#/components/headers/SandboxQuotaUnit" }, "X-CAIL-Sandbox-Quota-Mode": { "$ref": "#/components/headers/SandboxQuotaMode" }, "X-CAIL-Sandbox-Quota-State": { "$ref": "#/components/headers/SandboxQuotaState" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Running" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "410": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sandbox/v1/sandbox/{id}/exec": {
      "post": {
        "operationId": "execCommand",
        "parameters": [{ "$ref": "#/components/parameters/SandboxId" }, { "$ref": "#/components/parameters/App" }, { "$ref": "#/components/parameters/LeaseCapability" }, { "$ref": "#/components/parameters/SessionIdHeader" }, { "$ref": "#/components/parameters/OperationId" }, { "$ref": "#/components/parameters/OperationCapability" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExecRequest" } } } },
        "responses": {
          "200": { "description": "WHATWG event stream containing base64 stdout/stderr and exactly one terminal exit/error event; quota headers are the pre-command admission snapshot", "headers": { "X-CAIL-Sandbox-Quota-Limit": { "$ref": "#/components/headers/SandboxQuotaLimit" }, "X-CAIL-Sandbox-Quota-Used": { "$ref": "#/components/headers/SandboxQuotaUsed" }, "X-CAIL-Sandbox-Quota-Remaining": { "$ref": "#/components/headers/SandboxQuotaRemaining" }, "X-CAIL-Sandbox-Quota-Unit": { "$ref": "#/components/headers/SandboxQuotaUnit" }, "X-CAIL-Sandbox-Quota-Mode": { "$ref": "#/components/headers/SandboxQuotaMode" }, "X-CAIL-Sandbox-Quota-State": { "$ref": "#/components/headers/SandboxQuotaState" } }, "content": { "text/event-stream": { "schema": { "type": "string" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "410": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sandbox/v1/sandbox/{id}/file/{path}": {
      "parameters": [{ "$ref": "#/components/parameters/SandboxId" }, { "$ref": "#/components/parameters/FilePath" }, { "$ref": "#/components/parameters/App" }, { "$ref": "#/components/parameters/LeaseCapability" }, { "$ref": "#/components/parameters/SessionIdHeader" }, { "$ref": "#/components/parameters/OperationId" }, { "$ref": "#/components/parameters/OperationCapability" }],
      "get": {
        "operationId": "readFile",
        "responses": {
          "200": { "description": "Raw workspace-contained file bytes with the source MIME type preserved", "headers": { "X-CAIL-Sandbox-Quota-Limit": { "$ref": "#/components/headers/SandboxQuotaLimit" }, "X-CAIL-Sandbox-Quota-Used": { "$ref": "#/components/headers/SandboxQuotaUsed" }, "X-CAIL-Sandbox-Quota-Remaining": { "$ref": "#/components/headers/SandboxQuotaRemaining" }, "X-CAIL-Sandbox-Quota-Unit": { "$ref": "#/components/headers/SandboxQuotaUnit" }, "X-CAIL-Sandbox-Quota-Mode": { "$ref": "#/components/headers/SandboxQuotaMode" }, "X-CAIL-Sandbox-Quota-State": { "$ref": "#/components/headers/SandboxQuotaState" } }, "content": { "*/*": { "schema": { "type": "string", "format": "binary" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "410": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "operationId": "writeFile",
        "requestBody": { "required": true, "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } },
        "responses": {
          "200": { "description": "File written", "headers": { "X-CAIL-Sandbox-Quota-Limit": { "$ref": "#/components/headers/SandboxQuotaLimit" }, "X-CAIL-Sandbox-Quota-Used": { "$ref": "#/components/headers/SandboxQuotaUsed" }, "X-CAIL-Sandbox-Quota-Remaining": { "$ref": "#/components/headers/SandboxQuotaRemaining" }, "X-CAIL-Sandbox-Quota-Unit": { "$ref": "#/components/headers/SandboxQuotaUnit" }, "X-CAIL-Sandbox-Quota-Mode": { "$ref": "#/components/headers/SandboxQuotaMode" }, "X-CAIL-Sandbox-Quota-State": { "$ref": "#/components/headers/SandboxQuotaState" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "410": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sandbox/v1/sandbox/{id}/session": {
      "post": {
        "operationId": "createSession",
        "parameters": [{ "$ref": "#/components/parameters/SandboxId" }, { "$ref": "#/components/parameters/App" }, { "$ref": "#/components/parameters/LeaseCapability" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSessionRequest" } } } },
        "responses": {
          "201": { "description": "Explicit session and fenced operation acquired", "headers": { "X-CAIL-Sandbox-Quota-Limit": { "$ref": "#/components/headers/SandboxQuotaLimit" }, "X-CAIL-Sandbox-Quota-Used": { "$ref": "#/components/headers/SandboxQuotaUsed" }, "X-CAIL-Sandbox-Quota-Remaining": { "$ref": "#/components/headers/SandboxQuotaRemaining" }, "X-CAIL-Sandbox-Quota-Unit": { "$ref": "#/components/headers/SandboxQuotaUnit" }, "X-CAIL-Sandbox-Quota-Mode": { "$ref": "#/components/headers/SandboxQuotaMode" }, "X-CAIL-Sandbox-Quota-State": { "$ref": "#/components/headers/SandboxQuotaState" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionLifecycle" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "410": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sandbox/v1/sandbox/{id}/session/{sid}": {
      "delete": {
        "operationId": "destroySession",
        "parameters": [{ "$ref": "#/components/parameters/SandboxId" }, { "$ref": "#/components/parameters/SessionId" }, { "$ref": "#/components/parameters/App" }, { "$ref": "#/components/parameters/LeaseCapability" }, { "$ref": "#/components/parameters/OperationId" }, { "$ref": "#/components/parameters/OperationCapability" }],
        "responses": {
          "204": { "description": "Session destroyed" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "headers": {
      "SandboxQuotaLimit": { "description": "Configured per-principal sandbox allowance in GiB-seconds", "schema": { "type": "integer", "minimum": 0 } },
      "SandboxQuotaUsed": { "description": "Conservatively accrued sandbox use in whole GiB-seconds", "schema": { "type": "integer", "minimum": 0 } },
      "SandboxQuotaRemaining": { "description": "Remaining sandbox allowance in whole GiB-seconds", "schema": { "type": "integer", "minimum": 0 } },
      "SandboxQuotaUnit": { "schema": { "const": "gib-seconds" } },
      "SandboxQuotaMode": { "schema": { "enum": ["shadow", "admission", "enforce"] } },
      "SandboxQuotaState": { "schema": { "enum": ["ok", "exhausted"] } }
    },
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "Application-bound delegated CAIL key. Ordinary personal keys and query-string credentials are not accepted during the bounded pilot." },
      "identityJwtV2": { "type": "apiKey", "in": "header", "name": "X-CAIL-Identity-JWT-V2", "description": "Preferred RS256 CAIL session JWT with the cail:sandbox-bridge audience." },
      "identityJwt": { "type": "apiKey", "in": "header", "name": "X-CAIL-Identity-JWT", "description": "Compatibility CAIL session JWT. Removed after the V1 migration window." }
    },
    "parameters": {
      "App": { "name": "X-CAIL-App", "in": "header", "required": true, "description": "Validated attribution for session credentials. For delegated keys, the key-service application binding is authoritative and must match this value.", "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
      "SandboxId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "SessionId": { "name": "sid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "FilePath": { "name": "path", "in": "path", "required": true, "description": "Slash-preserving, percent-encoded path relative to /workspace", "schema": { "type": "string", "minLength": 1 } },
      "LeaseCapability": { "name": "X-CAIL-Sandbox-Lease", "in": "header", "required": true, "description": "Backend-only capability issued with the current lease generation", "schema": { "type": "string", "minLength": 32 } },
      "SessionIdHeader": { "name": "X-CAIL-Session-Id", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "OperationId": { "name": "X-CAIL-Operation-Id", "in": "header", "required": true, "description": "Backend-only opaque operation identifier", "schema": { "type": "string", "minLength": 32 } },
      "OperationCapability": { "name": "X-CAIL-Operation-Capability", "in": "header", "required": true, "description": "Backend-only capability issued by explicit session creation", "schema": { "type": "string", "minLength": 32 } }
    },
    "responses": {
      "Error": {
        "description": "CAIL nested error envelope",
        "headers": {
          "X-CAIL-Request-Id": { "required": true, "description": "Canonical inter-service correlation id", "schema": { "type": "string" } },
          "x-request-id": { "required": true, "schema": { "type": "string" } },
          "x-should-retry": { "required": true, "schema": { "type": "string", "enum": ["true", "false"] } },
          "X-CAIL-Sandbox-Quota-Limit": { "$ref": "#/components/headers/SandboxQuotaLimit" },
          "X-CAIL-Sandbox-Quota-Used": { "$ref": "#/components/headers/SandboxQuotaUsed" },
          "X-CAIL-Sandbox-Quota-Remaining": { "$ref": "#/components/headers/SandboxQuotaRemaining" },
          "X-CAIL-Sandbox-Quota-Unit": { "$ref": "#/components/headers/SandboxQuotaUnit" },
          "X-CAIL-Sandbox-Quota-Mode": { "$ref": "#/components/headers/SandboxQuotaMode" },
          "X-CAIL-Sandbox-Quota-State": { "$ref": "#/components/headers/SandboxQuotaState" }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "schemas": {
      "Health": { "type": "object", "required": ["status", "service"], "properties": { "status": { "const": "healthy" }, "service": { "const": "cail-sandbox-bridge" } }, "additionalProperties": false },
      "Ok": { "type": "object", "required": ["ok"], "properties": { "ok": { "const": true } }, "additionalProperties": false },
      "ControlValue": { "type": "string", "minLength": 32, "maxLength": 256, "pattern": "^[A-Za-z0-9._~-]+$" },
      "CreateSandboxRequest": { "type": "object", "required": ["scope_key", "idempotency_key"], "properties": { "scope_key": { "$ref": "#/components/schemas/ControlValue" }, "idempotency_key": { "$ref": "#/components/schemas/ControlValue" } }, "additionalProperties": false },
      "CreateSessionRequest": { "type": "object", "required": ["operation_id", "idempotency_key"], "properties": { "operation_id": { "$ref": "#/components/schemas/ControlValue" }, "idempotency_key": { "$ref": "#/components/schemas/ControlValue" } }, "additionalProperties": false },
      "SandboxLifecycle": { "type": "object", "required": ["id", "state", "expires_at", "lease_capability", "lease_generation"], "properties": { "id": { "type": "string", "format": "uuid" }, "state": { "const": "active" }, "expires_at": { "type": "string", "format": "date-time" }, "lease_capability": { "$ref": "#/components/schemas/ControlValue" }, "lease_generation": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
      "SessionLifecycle": { "type": "object", "required": ["id", "operation_capability", "operation_generation", "expires_at"], "properties": { "id": { "type": "string", "format": "uuid" }, "operation_capability": { "$ref": "#/components/schemas/ControlValue" }, "operation_generation": { "type": "integer", "minimum": 1 }, "expires_at": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
      "Running": { "type": "object", "required": ["running", "state", "expires_at", "incarnation", "lease_generation"], "properties": { "running": { "type": "boolean" }, "state": { "enum": ["active", "destroying", "destroyed"] }, "expires_at": { "type": "string", "format": "date-time" }, "incarnation": { "type": ["string", "null"] }, "lease_generation": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
      "ExecRequest": { "type": "object", "required": ["command", "session_id"], "properties": { "command": { "type": "string", "minLength": 1, "maxLength": 16384 }, "session_id": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
      "ErrorEnvelope": { "type": "object", "required": ["error"], "properties": { "error": { "$ref": "#/components/schemas/ErrorObject" } }, "additionalProperties": false },
      "ErrorObject": { "type": "object", "required": ["message", "type", "param", "code"], "properties": { "message": { "type": "string" }, "type": { "enum": ["invalid_request_error", "authentication_error", "permission_error", "conflict_error", "rate_limit_error", "server_error"] }, "param": { "type": ["string", "null"] }, "code": { "type": "string" }, "cail": { "type": "object", "additionalProperties": true } }, "additionalProperties": false }
    }
  }
}
