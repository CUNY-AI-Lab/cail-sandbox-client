{
  "name": "@cuny-ai-lab/cail-sandbox-client",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CUNY-AI-Lab/cail-sandbox-client.git"
  },
  "packageManager": "bun@1.3.14",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CONTRACT.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "lint": "oxlint .",
    "check": "bun run lint && bun run build && bun run typecheck && bun test && bun run package:dry-run",
    "package:dry-run": "bun pm pack --dry-run --ignore-scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "1.3.14",
    "@types/node": "^24.0.0",
    "oxlint": "1.79.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cuny-ai-lab/cail-log": "0.6.0",
    "eventsource-parser": "3.1.0",
    "zod": "4.4.3"
  }
}
