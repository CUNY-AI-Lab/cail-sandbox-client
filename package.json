{
  "name": "@cuny-ai-lab/cail-sandbox-client",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract/sandbox-openapi.json": "./contract/sandbox-openapi.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "contract",
    "dist",
    "src",
    "CONTRACT.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bun run check:gateway-contract && bun test",
    "check": "bun run check:gateway-contract && bun run typecheck && bun test && bun run build",
    "check:gateway-contract": "bun run scripts/check-gateway-contract.ts",
    "test:local:continuity": "bun run build && bun run scripts/local-continuity-e2e.ts",
    "test:live:continuity": "bun run build && bun run scripts/live-continuity-e2e.ts",
    "test:live": "bun run build && bun run scripts/live-e2e.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && git diff --exit-code -- dist",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cuny-ai-lab/cail-log": "github:CUNY-AI-Lab/cail-log#75e0dda3068794ae1543e1e2bb98c9c920bb848f",
    "eventsource-parser": "3.1.0"
  }
}
